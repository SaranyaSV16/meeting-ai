# Backend environment variables — set ALL of these in Railway

DEEPGRAM_API_KEY=
LYZR_API_KEY=
LYZR_AGENT_ID=
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# Frontend URL (set after Vercel deploy, so Railway CORS allows it)
FRONTEND_URL=https://YOUR-PROJECT.vercel.app

# Google ADK Executor (Agent 3)
# Leave blank to run in MOCK/DEMO mode
GOOGLE_SERVICE_ACCOUNT_JSON=/app/service-account.json
GOOGLE_DELEGATED_EMAIL=you@yourdomain.com
